@using SharpMod.Demo.Blazor.Services
@using SharpMod.Song
@inject PlayerService Player
@inject IJSRuntime JS
@implements IDisposable

<div class="ft2-pattern-area ft2-panel">

    <div class="ft2-chan-headers ft2-panel" id="patternHeaders">
        <div class="ft2-chan-header-rownum"></div>
        <div class="ft2-chan-headers-inner" id="patternHeadersInner">
            @for (int c = 0; c < channelCount; c++)
            {
                <div class="ft2-chan-header">Ch @((c + 1).ToString("D2"))</div>
            }
        </div>
    </div>

    <div class="ft2-pattern-grid-wrapper ft2-panel-inset">
        @if (currentPattern != null)
        {
            <div class="ft2-pattern-grid" id="patternGrid">
                <div class="ft2-pattern-grid-inner">
                    @for (int r = 0; r < rowCount; r++)
                    {
                        var row = r;
                        var isBar = row % 4 == 0;

                        <div class="ft2-row @(isBar ? "bar" : "")" id="prow_@row">
                            <span class="row-num">@row.ToString("X2")</span>
                            @for (int c = 0; c < channelCount; c++)
                            {
                                var cell = GetCell(row, c);
                                <span class="ft2-cell">
                                    <span class="note">@cell.Note</span>
                                    <span class="sep"> </span>
                                    <span class="inst">@cell.Inst</span>
                                    <span class="sep"> </span>
                                    <span class="vol">@cell.Vol</span>
                                    <span class="sep"> </span>
                                    <span class="fx">@cell.Fx</span>
                                    <span class="fxd">@cell.FxD</span>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ft2-dropzone">Load a module ── .MOD .S3M .XM</div>
        }
    </div>
</div>

@code {
    private static readonly string[] NoteNames =
        { "C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-" };

    private Pattern currentPattern;
    private int channelCount = 4;
    private int rowCount = 64;
    private int lastPatternNumber = -1;
    private int lastModuleHash = 0;

    protected override void OnInitialized()
    {
        Player.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        var module = Player.CurrentModule;
        if (module == null) return;

        int moduleHash = module.GetHashCode();
        if (moduleHash != lastModuleHash)
        {
            lastModuleHash = moduleHash;
            lastPatternNumber = -1;
            channelCount = module.ChannelsCount;
        }

        int patNum = Player.PatternNumber;

        if (patNum >= 0 && patNum < module.Patterns.Count && patNum != lastPatternNumber)
        {
            currentPattern = module.Patterns[patNum];
            rowCount = currentPattern.RowsCount;
            channelCount = module.ChannelsCount;
            lastPatternNumber = patNum;

            InvokeAsync(async () =>
            {
                StateHasChanged();
                await Task.Yield();
                try
                {
                    await JS.InvokeVoidAsync("ft2UpdatePatternGrid",
                        "patternGrid", rowCount);
                    await JS.InvokeVoidAsync("ft2SyncScrollInit",
                        "patternGrid", "patternHeadersInner");
                }
                catch { }
            });
        }
    }

    private (string Note, string Inst, string Vol, string Fx, string FxD) GetCell(int row, int channel)
    {
        if (currentPattern == null || channel >= currentPattern.Tracks.Count)
            return ("···", "··", "··", "·", "··");
        var track = currentPattern.Tracks[channel];
        if (track?.Cells == null || row >= track.Cells.Count)
            return ("···", "··", "··", "·", "··");
        var pc = track.Cells[row];
        if (pc == null)
            return ("···", "··", "··", "·", "··");

        string note = (pc.Note.HasValue && pc.Note.Value >= 0 && pc.Note.Value < 12)
            ? $"{NoteNames[pc.Note.Value]}{(pc.Octave.HasValue ? (pc.Octave.Value + 1).ToString() : "-")}"
            : "···";
        string inst = pc.Instrument != 0 ? pc.Instrument.ToString("X2") : "··";
        string vol = "··";
        string fx = (pc.Effect != 0 || pc.EffectData != 0) ? $"{pc.Effect:X1}" : "·";
        string fxd = (pc.Effect != 0 || pc.EffectData != 0) ? $"{pc.EffectData:X2}" : "··";
        return (note, inst, vol, fx, fxd);
    }

    public void Dispose()
    {
        Player.OnStateChanged -= OnStateChanged;
    }
}
