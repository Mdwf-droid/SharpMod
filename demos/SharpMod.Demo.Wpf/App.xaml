<Application
    x:Class="SharpMod.Demo.Wpf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--  Police globale  -->
            <FontFamily x:Key="Ft2Font">pack://application:,,,/Fonts/#Share Tech Mono</FontFamily>

            <!--  Style des boutons FT2  -->
            <Style x:Key="Ft2Button" TargetType="Button">
                <Setter Property="Background" Value="#1A2040" />
                <Setter Property="Foreground" Value="#D0D8E8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderBrush" Value="#2A3550" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#253060" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#304080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  TextBlock par défaut  -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Ft2Font}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
