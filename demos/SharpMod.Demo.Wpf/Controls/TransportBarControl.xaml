<UserControl x:Class="SharpMod.Demo.Wpf.Controls.TransportBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border Background="#131824" BorderBrush="#2A3550"
            BorderThickness="0,0,0,1" Padding="8,6">
		<DockPanel>
			<!-- ── Boutons transport ── -->
			<StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center">
				<Button Content="📂" Command="{Binding OpenFileCommand}"
                        Style="{StaticResource Ft2Button}" ToolTip="Open (Ctrl+O)" />
				<Button Content="▶" Command="{Binding PlayCommand}"
                        Style="{StaticResource Ft2Button}" Margin="4,0" />
				<Button Content="⏸" Command="{Binding PauseCommand}"
                        Style="{StaticResource Ft2Button}" />
				<Button Content="⏹" Command="{Binding StopCommand}"
                        Style="{StaticResource Ft2Button}" Margin="4,0" />
			</StackPanel>

			<!-- ── Infos module (droite) ── -->
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
				<TextBlock Text="Spd:" Foreground="#8090B0" Margin="8,0,2,0" FontSize="11" />
				<TextBlock Text="{Binding Speed}" Foreground="#D0D8E8" FontSize="11" />
				<TextBlock Text="Bpm:" Foreground="#8090B0" Margin="8,0,2,0" FontSize="11" />
				<TextBlock Text="{Binding Tempo}" Foreground="#D0D8E8" FontSize="11" />
				<TextBlock Text="Pos:" Foreground="#8090B0" Margin="8,0,2,0" FontSize="11" />
				<TextBlock Text="{Binding SongPosition, StringFormat='{}{0:D3}'}"
                           Foreground="#D0D8E8" FontSize="11" />
				<TextBlock Text="Pat:" Foreground="#8090B0" Margin="8,0,2,0" FontSize="11" />
				<TextBlock Text="{Binding PatternNumber, StringFormat='{}{0:D3}'}"
                           Foreground="#D0D8E8" FontSize="11" />
				<TextBlock Text="Row:" Foreground="#8090B0" Margin="8,0,2,0" FontSize="11" />
				<TextBlock Text="{Binding PatternPosition, StringFormat='{}{0:X2}'}"
                           Foreground="#D0D8E8" FontSize="11" />
			</StackPanel>

			<!-- ── Titre du module (centre) ── -->
			<TextBlock Text="{Binding SongName}"
                       Foreground="#D0D8E8" FontSize="14" FontWeight="Bold"
                       Margin="12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
		</DockPanel>
	</Border>
</UserControl>