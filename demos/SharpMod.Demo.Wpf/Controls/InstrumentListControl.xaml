<UserControl
    x:Class="SharpMod.Demo.Wpf.Controls.InstrumentListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="4" Background="#0A0D12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="4,2"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#8090B0"
                Text="Instruments" />

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentModule.Instruments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,1" Orientation="Horizontal">
                                <TextBlock
                                    Width="20"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#4A5580"
                                    Text="{Binding InsNum, StringFormat='{}{0:D2}'}" />
                                <TextBlock
                                    Margin="6,0"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#D0D8E8"
                                    Text="{Binding InsName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
