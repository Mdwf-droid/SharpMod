<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ═══ Palette FT2 (WPF Brushes — synchro avec Ft2Theme.cs) ═══  -->
    <Color x:Key="Ft2Bg">#0B0E14</Color>
    <Color x:Key="Ft2Panel">#101520</Color>
    <Color x:Key="Ft2PanelLight">#1A2030</Color>
    <Color x:Key="Ft2Border">#2A3550</Color>
    <Color x:Key="Ft2Text">#8090B0</Color>
    <Color x:Key="Ft2TextBright">#D0D8E8</Color>
    <Color x:Key="Ft2Accent">#FFD040</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Ft2Bg}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Ft2Panel}" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource Ft2PanelLight}" />
    <SolidColorBrush x:Key="Ft2BorderBrush" Color="{StaticResource Ft2Border}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Ft2Text}" />
    <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource Ft2TextBright}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Ft2Accent}" />

    <!--  ═══ Bouton transport ═══  -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelLightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ft2BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Ft2BorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ═══ Panel ═══  -->
    <Style x:Key="Ft2Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ft2BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  ═══ Labels ═══  -->
    <Style x:Key="Ft2Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="Ft2Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
    </Style>

    <!--  REMPLACER le style Ft2HScrollBar existant dans Window.Resources  -->
    <Style x:Key="Ft2HScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="#0B0E14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#0B0E14">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageLeftCommand"
                                    IsTabStop="False"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border
                                                            Margin="0,2"
                                                            Background="#2A3550"
                                                            BorderBrush="#3A4560"
                                                            BorderThickness="1"
                                                            CornerRadius="2" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Margin="0,2"
                                                                    Background="#3A4560"
                                                                    BorderBrush="#506080"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageRightCommand"
                                    IsTabStop="False"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
