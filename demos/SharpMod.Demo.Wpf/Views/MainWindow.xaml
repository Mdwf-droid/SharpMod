<Window x:Class="SharpMod.Demo.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SharpMod.Demo.Wpf.Controls"
        Title="SharpMod — Tracker Player"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="600"
        AllowDrop="True"
        Drop="OnFileDrop"
        DragOver="OnDragOver">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0E14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101520" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1A2030" />
        <SolidColorBrush x:Key="Ft2BorderBrush" Color="#2A3550" />
        <SolidColorBrush x:Key="TextBrush" Color="#8090B0" />
        <SolidColorBrush x:Key="TextBrightBrush" Color="#D0D8E8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD040" />

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ft2BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource Ft2BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource BgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ft2Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ft2BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Ft2Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Ft2Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
        </Style>
    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="#0B0E14" />
    </Window.Background>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0 : Transport ═══ -->
        <Border Grid.Row="0" Style="{StaticResource Ft2Panel}" Margin="0,0,0,2"
                Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="▶ Play" Style="{StaticResource TransportButton}"
                            Click="OnPlay" Margin="0,0,4,0" />
                    <Button Content="⏸ Pause" Style="{StaticResource TransportButton}"
                            Click="OnPause" Margin="0,0,4,0" />
                    <Button Content="⏹ Stop" Style="{StaticResource TransportButton}"
                            Click="OnStop" Margin="0,0,12,0" />
                    <Button Content="📂 Open" Style="{StaticResource TransportButton}"
                            Click="OnOpen" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Ft2Label}" Text="Spd " />
                    <TextBlock Style="{StaticResource Ft2Value}"
                               Text="{Binding Speed, FallbackValue=6}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Ft2Label}" Text="BPM " />
                    <TextBlock Style="{StaticResource Ft2Value}"
                               Text="{Binding Bpm, FallbackValue=125}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Ft2Label}" Text="Ch " />
                    <TextBlock Style="{StaticResource Ft2Value}"
                               Text="{Binding ChannelCount, FallbackValue=4}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Ft2Value}" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0"
                           Text="{Binding ModuleTitle, FallbackValue='SharpMod ── Drop a .MOD .S3M .XM file'}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ═══ Row 1 : Positions + FFT ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Ft2Panel}" Margin="0,0,2,0"
                    Padding="6,4">
                <StackPanel>
                    <TextBlock Style="{StaticResource Ft2Label}" Text="Positions"
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ft2Label}" Text="Sng " Width="32"/>
                        <TextBlock Style="{StaticResource Ft2Value}"
                                   Text="{Binding SongPositionDisplay, FallbackValue='000'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ft2Label}" Text="Pat " Width="32"/>
                        <TextBlock Style="{StaticResource Ft2Value}"
                                   Text="{Binding PatternNumberDisplay, FallbackValue='000'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ft2Label}" Text="Row " Width="32"/>
                        <TextBlock Style="{StaticResource Ft2Value}"
                                   Text="{Binding PatternPositionDisplay, FallbackValue='00'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ★ DrawingVisual natif au lieu de SKElement -->
            <Border Grid.Column="1" Style="{StaticResource Ft2Panel}">
                <ctrl:SpectrumVisual x:Name="SpectrumVis" />
            </Border>
        </Grid>

        <!-- ═══ Row 2 : Scopes + VU ═══ -->
        <!-- ★ DrawingVisual natif au lieu de SKElement -->
        <Border Grid.Row="2" Style="{StaticResource Ft2Panel}" Margin="0,0,0,2">
            <ctrl:ScopesVuVisual x:Name="ScopesVuVis" />
        </Border>

        <!-- ═══ Row 3 : Channel headers ═══ -->
        <Border Grid.Row="3" Style="{StaticResource Ft2Panel}" Margin="0,0,0,0"
                Padding="0,2">
            <ItemsControl x:Name="ChannelHeadersBar">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ═══ Row 4 : Pattern editor ═══ -->
        <Border Grid.Row="4" Style="{StaticResource Ft2Panel}" Margin="0,2,0,2">
            <ctrl:PatternEditorControl x:Name="PatternEditor" />
        </Border>

        <!-- ═══ Row 5 : Status ═══ -->
        <Border Grid.Row="5" Style="{StaticResource Ft2Panel}" Padding="6,2">
            <TextBlock Style="{StaticResource Ft2Label}"
                       Text="{Binding StatusMessage, FallbackValue='Ready ── Drop a .MOD .S3M .XM file'}" />
        </Border>
    </Grid>
</Window>
